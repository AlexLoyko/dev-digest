{
  "mcpServers": {
    "devdigest": {
      "type": "stdio",
      "command": "mcp-server/node_modules/.bin/tsx",
      "args": ["mcp-server/src/index.ts"],
      "env": {
        "DEVDIGEST_API_URL": "http://127.0.0.1:3001",
        "DEVDIGEST_MCP_RUN_TIMEOUT_MS": "240000",
        "TSX_TSCONFIG_PATH": "mcp-server/tsconfig.json"
      }
    }
  }
}
